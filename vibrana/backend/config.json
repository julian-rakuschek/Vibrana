{
  "mongo": {
    "url": "mongodb://localhost:27017/",
    "docker_url": "mongodb://vibrana_mongodb:27017/",
    "db": "VibranaDB"
  },
  "redis": {
    "host": "localhost",
    "docker_host": "vibrana_redis",
    "port": 6379
  },
